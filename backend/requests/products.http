@baseUrl = http://localhost:5165
@user = master1
@roles = MasterMaintainer

### 商品一覧
GET {{baseUrl}}/api/products?isDiscontinued=false
X-Dummy-User: {{user}}

### 商品新規登録
POST {{baseUrl}}/api/products
Content-Type: application/json
X-Dummy-User: {{user}}
X-Dummy-Roles: {{roles}}

{
  "productCode": "P001",
  "name": "コピー用紙 A4",
  "unit": "箱",
  "standardUnitPrice": 1200,
  "taxCategory": "STANDARD",
  "isDiscontinued": false,
  "effectiveFrom": "2026-01-01"
}

### 指定日時点の商品情報
GET {{baseUrl}}/api/products/1?asOf=2026-04-15
X-Dummy-User: {{user}}

### 商品変更履歴一覧
GET {{baseUrl}}/api/products/1/changes
X-Dummy-User: {{user}}

### 指定日からの商品情報変更
POST {{baseUrl}}/api/products/1/changes
Content-Type: application/json
X-Dummy-User: {{user}}
X-Dummy-Roles: {{roles}}

{
  "name": "コピー用紙 A4 改定",
  "unit": "箱",
  "standardUnitPrice": 1300,
  "taxCategory": "STANDARD",
  "isDiscontinued": false,
  "effectiveFrom": "2026-04-01"
}
